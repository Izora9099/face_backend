# Copy to .env and adjust. Never commit .env.

# Django signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# It also encrypts stored face encodings: keep it stable and copy it with the
# database when moving machines. To change it on an existing database run
#   python manage.py rotate_encryption_key --old-secret-key '<old key>'
SECRET_KEY=change-me
DEBUG=True

# Comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1
# The React admin (Vite dev server) runs on :8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Defaults to SQLite in the project root. Postgres example:
#   DATABASE_URL=postgres://faceit:faceit@localhost:5432/faceit
DATABASE_URL=sqlite:///db.sqlite3

# Max face distance for a match (face_recognition, 128-d). Lower = stricter.
# 0.6 is the library default; see `python manage.py evaluate_recognition`.
FACE_MATCH_THRESHOLD=0.6
# hog (CPU, fast) or cnn (accurate, slow without GPU)
FACE_DETECTION_MODEL=hog
